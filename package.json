{
  "name": "@nestarc/soft-delete",
  "version": "0.7.4",
  "description": "Prisma soft-delete extension for NestJS with automatic query filtering, cascade support, and restore API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "bench": "prisma generate --schema=test/prisma/schema.prisma && tsx benchmarks/soft-delete-overhead.ts",
    "pretest:e2e": "prisma generate --schema=test/prisma/schema.prisma",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "pretest:e2e:cross-package": "prisma generate --schema=test/prisma/schema.prisma",
    "test:e2e:cross-package": "vitest run --config vitest.e2e.config.ts test/e2e/audit-integration.e2e-spec.ts",
    "test:e2e:tenancy-candidate": "node scripts/test-tenancy-candidate.js",
    "test:types": "npm run build && tsc -p tsconfig.public-types.json",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@nestarc/audit-log": "^0.4.1 || ^0.5.0 || ^0.6.0 || ^0.7.0",
    "@nestarc/tenancy": "^0.15.0 || ^0.16.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/event-emitter": "^2.0.0 || ^3.0.0",
    "@prisma/client": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestarc/tenancy": {
      "optional": true
    },
    "@nestarc/audit-log": {
      "optional": true
    },
    "@nestjs/event-emitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestarc/audit-log": "0.4.1",
    "@nestarc/tenancy": "0.15.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/internals": "^7.9.1",
    "@types/node": "^25.5.2",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.2.0",
    "pg": "^8.22.0",
    "prettier": "^3.0.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tsup": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nestarc/nestjs-soft-delete"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "docs/recipes",
    "!dist/.tsbuildinfo"
  ],
  "keywords": [
    "nestjs",
    "soft-delete",
    "soft-deletion",
    "prisma",
    "prisma-extension",
    "cascade-delete",
    "restore",
    "deleted-at",
    "paranoid",
    "nestjs-module",
    "saas"
  ],
  "license": "MIT"
}
